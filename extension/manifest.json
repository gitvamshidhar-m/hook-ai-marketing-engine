{
  "manifest_version": 3,
  "name": "Hook AI — Hook Generator (beta)",
  "version": "1.0.0",
  "description": "Write a CTR-predicted marketing hook for any selected text. Right-click anywhere → \"Write a hook for this\".",
  "permissions": ["contextMenus", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hook AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}